# Copy to .streamlit/secrets.toml and replace placeholders locally.
# Never commit the resulting secrets.toml.

[database]
host = "127.0.0.1"
port = 3306
name = "sems_db"
user = "sems_app"
password = "REPLACE_WITH_LOCAL_PASSWORD"
pool_size = 5
max_overflow = 10
connect_timeout = 5

[auth.credentials]
"admin@sems.local" = "REPLACE_WITH_BCRYPT_HASH"
"faculty.embedded@sems.local" = "REPLACE_WITH_BCRYPT_HASH"
"assistant.embedded@sems.local" = "REPLACE_WITH_BCRYPT_HASH"
"student.vlsi@sems.local" = "REPLACE_WITH_BCRYPT_HASH"
