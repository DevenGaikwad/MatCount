# Copy to .env and replace placeholders locally. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sems_db
DB_USER=sems_app
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=5
LOG_LEVEL=INFO

# JSON object mapping seeded USER.email values to bcrypt hashes.
# Generate each hash with: python scripts/generate_demo_hash.py
SEMS_DEMO_CREDENTIALS_JSON={"admin@sems.local":"REPLACE_WITH_BCRYPT_HASH"}

# Thin API settings. Origins are deliberately explicit; never use * with credentials.
SEMS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEMS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SEMS_API_SESSION_TTL_MINUTES=480
